{
  "appId": "uz.myserviceuz.app",
  "appName": "MyService",
  "webDir": "www",
  "server": {
    "url": "https://myserviceuz.uz/dashboard",
    "errorPath": "offline.html",
    "allowNavigation": ["myserviceuz.uz", "www.myserviceuz.uz"]
  },
  "ios": {
    "appendUserAgent": "MyServiceApp-iOS",
    "contentInset": "never",
    "backgroundColor": "#ffffff",
    "limitsNavigationsToAppBoundDomains": true,
    "scheme": "MyService"
  },
  "plugins": {
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
