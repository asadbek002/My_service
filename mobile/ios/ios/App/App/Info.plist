<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>uz</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>uz</string>
		<string>ru</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>MyService</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
		<string>tel</string>
	</array>
	<!-- Only HTTPS with standard encryption: no export compliance documents needed. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The web view may load (and run the Capacitor bridge and the service worker in) only these domains. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>myserviceuz.uz</string>
		<string>www.myserviceuz.uz</string>
	</array>
	<!-- Shown by iOS when the app first asks; without them iOS closes the app when the camera or photos are opened. -->
	<key>NSCameraUsageDescription</key>
	<string>Qabul qilinayotgan qurilmaning holatini (ekran, korpus, nuqsonlar) suratga olish uchun kamera kerak.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Qurilma rasmlari va servis logotipini galereyadan tanlash uchun ruxsat kerak.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Chek va hisobotni galereyaga saqlash uchun ruxsat kerak.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
