generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  INVITED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  orders Order[]
  parts Part[]
  subscription Subscription?
  branches Branch[]
  users    User[]
  roles    Role[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships UserBranch[]
  stocks Stock[]
  orders Order[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                 String      @id @default(cuid())
  organizationId     String
  login              String      @unique
  passwordHash       String
  firstName          String
  lastName           String?
  phone              String
  email              String?
  status             StaffStatus @default(ACTIVE)
  mustChangePassword Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     UserBranch[]
  roles        UserRole[]
  sessions     Session[]
  assignments OrderAssignment[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model UserBranch {
  organizationId String
  userId         String
  branchId       String

  user   User   @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, branchId])
  @@index([organizationId, branchId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  organizationId String
  userId         String
  roleId         String

  user User @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, roleId])
  @@index([organizationId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  tokenFamilyId    String
  refreshTokenHash String
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime      @default(now())
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tokenFamilyId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityId       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model Plan {
  id            String @id @default(cuid())
  name          String @unique
  maxBranches   Int?
  maxStaff      Int?
  monthlyOrders Int?
  features      Json
  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique
  planId         String
  status         String   @default("TRIAL")
  expiresAt      DateTime
  graceUntil     DateTime?
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model Customer {
  id String @id @default(cuid())
  organizationId String
  firstName String
  phone String
  notes String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  devices Device[]
  orders Order[]
  @@unique([organizationId, id])
  @@unique([organizationId, phone])
}
model Device {
  id String @id @default(cuid())
  organizationId String
  customerId String
  category String
  brand String
  model String
  imei String?
  serialNumber String?
  color String?
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  orders Order[]
  @@unique([organizationId, customerId, id])
  @@index([organizationId, imei])
}
model OrderCounter {
  organizationId String
  day String
  value Int @default(0)
  @@id([organizationId, day])
}
model Order {
  id String @id @default(cuid())
  organizationId String
  branchId String
  customerId String
  deviceId String
  number String
  status String @default("RECEIVED")
  complaint String
  accessories String[]
  condition String[]
  diagnosis String?
  requiredWork String?
  quoteVersion Int @default(0)
  approvedVersion Int?
  approvalStatus String @default("PENDING")
  approvalChannel String?
  approvedAt DateTime?
  labor Decimal @default(0) @db.Decimal(18, 2)
  partsTotal Decimal @default(0) @db.Decimal(18, 2)
  total Decimal @default(0) @db.Decimal(18, 2)
  finalTest Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  device Device @relation(fields: [organizationId, customerId, deviceId], references: [organizationId, customerId, id], onDelete: Restrict)
  assignments OrderAssignment[]
  history OrderHistory[]
  parts OrderPart[]
  payments Payment[]
  repairSessions RepairSession[]
  warranty Warranty?
  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, branchId, status])
}
model OrderAssignment {
  organizationId String
  orderId String
  userId String
  task String
  order Order @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  user User @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  @@id([organizationId, orderId, userId])
}
model OrderHistory {
  id String @id @default(cuid())
  organizationId String
  orderId String
  fromStatus String?
  toStatus String
  actorId String
  comment String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, orderId, createdAt])
}
model OutboxEvent {
  id String @id @default(cuid())
  organizationId String
  type String
  entityId String
  payload Json
  createdAt DateTime @default(now())
  publishedAt DateTime?
  @@index([publishedAt, createdAt])
}

model Part {
  id String @id @default(cuid())
  organizationId String
  name String
  sku String
  purchasePrice Decimal @db.Decimal(18,2)
  salePrice Decimal @db.Decimal(18,2)
  minimumQuantity Int @default(0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stocks Stock[]
  orderParts OrderPart[]
  @@unique([organizationId,id])
  @@unique([organizationId,sku])
}
model Stock {
  organizationId String
  branchId String
  partId String
  onHand Int @default(0)
  reserved Int @default(0)
  branch Branch @relation(fields: [organizationId,branchId], references: [organizationId,id], onDelete: Restrict)
  part Part @relation(fields: [organizationId,partId], references: [organizationId,id], onDelete: Restrict)
  @@id([organizationId,branchId,partId])
}
model InventoryMovement {
  id String @id @default(cuid())
  organizationId String
  branchId String
  partId String
  orderId String?
  type String
  quantity Int
  reason String
  actorId String
  createdAt DateTime @default(now())
  @@index([organizationId,branchId,partId,createdAt])
}
model OrderPart {
  id String @id @default(cuid())
  organizationId String
  orderId String
  partId String
  quantity Int
  status String @default("RESERVED")
  unitCost Decimal @db.Decimal(18,2)
  unitPrice Decimal @db.Decimal(18,2)
  order Order @relation(fields: [organizationId,orderId], references: [organizationId,id], onDelete: Restrict)
  part Part @relation(fields: [organizationId,partId], references: [organizationId,id], onDelete: Restrict)
  @@unique([organizationId,orderId,partId])
}
model Payment {
  id String @id @default(cuid())
  organizationId String
  orderId String
  kind String
  amount Decimal @db.Decimal(18,2)
  method String
  originalPaymentId String?
  reason String?
  idempotencyKey String
  actorId String
  createdAt DateTime @default(now())
  order Order @relation(fields: [organizationId,orderId], references: [organizationId,id], onDelete: Restrict)
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,orderId])
}
model RepairSession {
  id String @id @default(cuid())
  organizationId String
  orderId String
  userId String
  startedAt DateTime @default(now())
  endedAt DateTime?
  order Order @relation(fields: [organizationId,orderId], references: [organizationId,id], onDelete: Restrict)
  @@index([organizationId,orderId,userId])
}
model Warranty {
  id String @id @default(cuid())
  organizationId String
  orderId String @unique
  startDate DateTime
  endDate DateTime
  terms String
  order Order @relation(fields: [organizationId,orderId], references: [organizationId,id], onDelete: Restrict)
  @@index([organizationId,endDate])
}
