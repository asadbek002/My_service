generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  INVITED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships UserBranch[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                 String      @id @default(cuid())
  organizationId     String
  login              String      @unique
  passwordHash       String
  firstName          String
  lastName           String?
  phone              String
  email              String?
  status             StaffStatus @default(ACTIVE)
  mustChangePassword Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     UserBranch[]
  roles        UserRole[]
  sessions     Session[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model UserBranch {
  organizationId String
  userId         String
  branchId       String

  user   User   @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, branchId])
  @@index([organizationId, branchId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  organizationId String
  userId         String
  roleId         String

  user User @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, roleId])
  @@index([organizationId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  tokenFamilyId    String
  refreshTokenHash String
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime      @default(now())
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tokenFamilyId])
}
