NODE_ENV=development
DATABASE_URL=postgresql://myservice:myservice@localhost:5432/myservice?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

INITIAL_OWNER_LOGIN=asadbek1035
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_PHONE=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=myservice
S3_ACCESS_KEY=myservice
S3_SECRET_KEY=replace-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Test-only override; production always uses api.telegram.org
TELEGRAM_API_URL=

# ==============================================================================
# SMS Provayder sozlamalari (Eskiz.uz yoki generic webhook)
# ==============================================================================
# Tanlang: 'eskiz' yoki 'webhook'
SMS_PROVIDER=eskiz

# Eskiz.uz API sozlamalari:
# 1. SMS_API_KEY: Eskiz.uz kabinetidagi ro'yxatdan o'tgan email
# 2. SMS_API_SECRET: Eskiz.uz kabinetidagi parol
# 3. SMS_FROM: Tasdiqlangan sender nomi (test hisoblar uchun: '4546')
# 4. ESKIZ_TEST_MODE: true bo'lsa test matnlari ishlatiladi (test hisoblari uchun)
# 5. ESKIZ_CALLBACK_URL: SMS yetkazilganlik holati (delivery report) uchun webhook URL
SMS_API_KEY=your-email@example.com
SMS_API_SECRET=your-eskiz-password
SMS_FROM=4546
ESKIZ_TEST_MODE=false
ESKIZ_CALLBACK_URL=

# Generic Webhook provayderlar uchun (agar SMS_PROVIDER=webhook bo'lsa):
# SMS_API_KEY=your-bearer-token
# SMS_API_URL=https://your-sms-provider.com/api/send

WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

NOTIFICATIONS_ENABLED=false

INITIAL_PLATFORM_ADMIN_LOGIN=
INITIAL_PLATFORM_ADMIN_PASSWORD=
